{
  "routes": [
    {
      "route": "/data/*",
      "allowedRoles": [
        "bloqueado"
      ]
    },
    {
      "route": "/scripts/*",
      "allowedRoles": [
        "bloqueado"
      ]
    },
    {
      "route": "/CLAUDE.md",
      "allowedRoles": [
        "bloqueado"
      ]
    },
    {
      "route": "/SEO-IMPLEMENTATION.md",
      "allowedRoles": [
        "bloqueado"
      ]
    },
    {
      "route": "/",
      "rewrite": "/home.html"
    },
    {
      "route": "/trajetoria",
      "rewrite": "/trajetoria.html"
    },
    {
      "route": "/portfolio",
      "rewrite": "/portfolio.html"
    },
    {
      "route": "/ideias",
      "rewrite": "/ideias.html"
    },
    {
      "route": "/midia",
      "rewrite": "/midia.html"
    },
    {
      "route": "/sobre",
      "rewrite": "/sobre.html"
    },
    {
      "route": "/links",
      "rewrite": "/links.html"
    },
    {
      "route": "/en",
      "rewrite": "/en/home.html"
    },
    {
      "route": "/en/journey",
      "rewrite": "/en/journey.html"
    },
    {
      "route": "/en/portfolio",
      "rewrite": "/en/portfolio.html"
    },
    {
      "route": "/en/ideas",
      "rewrite": "/en/ideas.html"
    },
    {
      "route": "/en/press",
      "rewrite": "/en/press.html"
    },
    {
      "route": "/en/about",
      "rewrite": "/en/about.html"
    },
    {
      "route": "/en/links",
      "rewrite": "/en/links.html"
    },
    {
      "route": "/home.html",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/index.html",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/trajetoria.html",
      "redirect": "/trajetoria",
      "statusCode": 301
    },
    {
      "route": "/portfolio.html",
      "redirect": "/portfolio",
      "statusCode": 301
    },
    {
      "route": "/ideias.html",
      "redirect": "/ideias",
      "statusCode": 301
    },
    {
      "route": "/en/ideas.html",
      "redirect": "/en/ideas",
      "statusCode": 301
    },
    {
      "route": "/midia.html",
      "redirect": "/midia",
      "statusCode": 301
    },
    {
      "route": "/sobre.html",
      "redirect": "/sobre",
      "statusCode": 301
    },
    {
      "route": "/links.html",
      "redirect": "/links",
      "statusCode": 301
    },
    {
      "route": "/en/home.html",
      "redirect": "/en",
      "statusCode": 301
    },
    {
      "route": "/en/journey.html",
      "redirect": "/en/journey",
      "statusCode": 301
    },
    {
      "route": "/en/portfolio.html",
      "redirect": "/en/portfolio",
      "statusCode": 301
    },
    {
      "route": "/en/press.html",
      "redirect": "/en/press",
      "statusCode": 301
    },
    {
      "route": "/en/about.html",
      "redirect": "/en/about",
      "statusCode": 301
    },
    {
      "route": "/en/links.html",
      "redirect": "/en/links",
      "statusCode": 301
    },
    {
      "route": "/assets/fonts/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/assets/img/logos/*",
      "headers": {
        "cache-control": "public, max-age=604800"
      }
    },
    {
      "route": "/assets/img/og/*",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    },
    {
      "route": "/assets/img/icon/*",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    },
    {
      "route": "/assets/img/*",
      "headers": {
        "cache-control": "public, max-age=2592000"
      }
    },
    {
      "route": "/favicon.ico",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    },
    {
      "route": "/robots.txt",
      "headers": {
        "content-type": "text/plain; charset=utf-8"
      }
    },
    {
      "route": "/llms.txt",
      "headers": {
        "content-type": "text/plain; charset=utf-8"
      }
    },
    {
      "route": "/sitemap.xml",
      "headers": {
        "content-type": "application/xml"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".webp": "image/webp"
  }
}
