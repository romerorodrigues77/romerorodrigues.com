{
  "routes": [
    { "route": "/data/*", "allowedRoles": ["bloqueado"] },
    { "route": "/scripts/*", "allowedRoles": ["bloqueado"] },
    { "route": "/CLAUDE.md", "allowedRoles": ["bloqueado"] },
    { "route": "/SEO-IMPLEMENTATION.md", "allowedRoles": ["bloqueado"] },

    { "route": "/", "rewrite": "/home.html" },
    { "route": "/index.html", "rewrite": "/home.html" },
    { "route": "/trajetoria", "rewrite": "/trajetoria.html" },
    { "route": "/portfolio", "rewrite": "/portfolio.html" },
    { "route": "/sobre", "rewrite": "/sobre.html" },
    { "route": "/links", "rewrite": "/links.html" },

    { "route": "/robots.txt", "headers": { "content-type": "text/plain; charset=utf-8" } },
    { "route": "/llms.txt", "headers": { "content-type": "text/plain; charset=utf-8" } },
    { "route": "/sitemap.xml", "headers": { "content-type": "application/xml" } }
  ],
  "responseOverrides": {
    "401": { "rewrite": "/404.html", "statusCode": 404 },
    "403": { "rewrite": "/404.html", "statusCode": 404 },
    "404": { "rewrite": "/404.html", "statusCode": 404 }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": { ".webp": "image/webp" }
}
