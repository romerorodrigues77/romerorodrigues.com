{
  "routes": [
    { "route": "/data/*", "allowedRoles": ["bloqueado"] },
    { "route": "/scripts/*", "allowedRoles": ["bloqueado"] },
    { "route": "/CLAUDE.md", "allowedRoles": ["bloqueado"] },
    { "route": "/SEO-IMPLEMENTATION.md", "allowedRoles": ["bloqueado"] },

    { "route": "/", "rewrite": "/home.html" },
    { "route": "/index.html", "rewrite": "/home.html" },
    { "route": "/trajetoria", "rewrite": "/trajetoria.html" },
    { "route": "/portfolio", "rewrite": "/portfolio.html" },
    { "route": "/midia", "rewrite": "/midia.html" },
    { "route": "/sobre", "rewrite": "/sobre.html" },
    { "route": "/links", "rewrite": "/links.html" },

    { "route": "/en", "rewrite": "/en/home.html" },
    { "route": "/en/journey", "rewrite": "/en/journey.html" },
    { "route": "/en/portfolio", "rewrite": "/en/portfolio.html" },
    { "route": "/en/press", "rewrite": "/en/press.html" },
    { "route": "/en/about", "rewrite": "/en/about.html" },
    { "route": "/en/links", "rewrite": "/en/links.html" },

    { "route": "/assets/fonts/*", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "route": "/assets/img/logos/*", "headers": { "cache-control": "public, max-age=604800" } },
    { "route": "/assets/img/og/*", "headers": { "cache-control": "public, max-age=86400" } },
    { "route": "/assets/img/icon/*", "headers": { "cache-control": "public, max-age=86400" } },
    { "route": "/assets/img/*", "headers": { "cache-control": "public, max-age=2592000" } },
    { "route": "/favicon.ico", "headers": { "cache-control": "public, max-age=86400" } },

    { "route": "/robots.txt", "headers": { "content-type": "text/plain; charset=utf-8" } },
    { "route": "/llms.txt", "headers": { "content-type": "text/plain; charset=utf-8" } },
    { "route": "/sitemap.xml", "headers": { "content-type": "application/xml" } }
  ],
  "responseOverrides": {
    "401": { "rewrite": "/404.html", "statusCode": 404 },
    "403": { "rewrite": "/404.html", "statusCode": 404 },
    "404": { "rewrite": "/404.html", "statusCode": 404 }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": { ".webp": "image/webp" }
}
